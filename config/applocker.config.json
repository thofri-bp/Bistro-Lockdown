{
  "modeDefaults": {
    "defaultMode": "AuditOnly"
  },
  "allowedPaths": [
    {
      "name": "Windows",
      "path": "%WINDIR%\\*",
      "collections": [
        "Exe",
        "Msi",
        "Script"
      ],
      "description": "Windows-Bestandteile und systemnahe Tools."
    },
    {
      "name": "Program Files",
      "path": "%PROGRAMFILES%\\*",
      "collections": [
        "Exe",
        "Msi",
        "Script"
      ],
      "description": "Klassische 64-Bit-Installationen."
    },
    {
      "name": "Program Files x86",
      "path": "%PROGRAMFILES(X86)%\\*",
      "collections": [
        "Exe",
        "Msi",
        "Script"
      ],
      "description": "Klassische 32-Bit-Installationen."
    }
  ],
  "allowedFiles": [],
  "allowedPublishers": [
    {
      "name": "Microsoft signed applications",
      "publisherName": "O=MICROSOFT CORPORATION, L=REDMOND, S=WASHINGTON, C=US",
      "productName": "*",
      "binaryName": "*",
      "lowVersion": "*",
      "highVersion": "*",
      "collections": [
        "Exe",
        "Msi",
        "Script",
        "Appx"
      ],
      "description": "Standardregel fuer signierte Microsoft-Komponenten."
    }
  ]
}
