      "productName": "*",
      "binaryName": "*",
      "lowVersion": "*",
      "highVersion": "*",
      "collections": [
        "Exe",
        "Msi",
        "Script",
        "Appx"
      ],
      "description": "Standardregel fuer signierte Microsoft-Komponenten."
    },
    {
      "name": "Vendor updater placeholder",
      "publisherName": "O=VENDOR GMBH, L=STADT, S=BUNDESLAND, C=DE",
      "productName": "Vendor Updater",
      "binaryName": "*",
      "lowVersion": "*",
      "highVersion": "*",
      "collections": [
        "Exe",
        "Msi"
      ],
      "description": "Beispiel fuer freigegebene Drittanbieter-Updater."
    }
  ]
