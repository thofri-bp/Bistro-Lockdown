{
  "modeDefaults": {
    "defaultMode": "AuditOnly"
  },
  "allowedPaths": [
    {
      "name": "Windows",
      "path": "%WINDIR%\\*",
      "collections": [
        "Exe",
        "Msi",
        "Script"
      ],
      "description": "Windows-Bestandteile und systemnahe Tools."
    },
    {
      "name": "Program Files",
      "path": "%PROGRAMFILES%\\*",
      "collections": [
        "Exe",
        "Msi",
        "Script"
      ],
      "description": "Klassische 64-Bit-Installationen."
    },
    {
      "name": "Program Files x86",
      "path": "%PROGRAMFILES(X86)%\\*",
      "collections": [
        "Exe",
        "Msi",
        "Script"
      ],
      "description": "Klassische 32-Bit-Installationen."
    }
  ],
  "allowedFiles": [
    {
      "name": "Line-of-business app placeholder",
      "path": "C:\\Program Files\\Vendor\\BookingApp\\BookingApp.exe",
      "collections": [
        "Exe"
      ],
